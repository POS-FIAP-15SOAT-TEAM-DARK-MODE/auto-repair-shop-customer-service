PORT=8081
LOG_LEVEL=INFO

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=24h
BCRYPT_COST=12

# Shared secret for /internal/* (service-to-service). Empty = every internal call is rejected.
INTERNAL_TOKEN=change-me-internal-token

# Seeds the staff users and customers A/B only when true (never in prd).
SEED_ENABLED=false
